# ===========================================================================
# Jewellery Shop ERP - environment template
#
# Copy to .env (which is git-ignored) and fill in real values, or export these
# in your deployment environment. Nothing here has a usable default: the
# application refuses to start without a JWT secret rather than falling back to
# a well-known one.
# ===========================================================================

# --- Runtime ---------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- Database --------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/jewellery_erp
DB_USERNAME=jewellery
DB_PASSWORD=change-me
DB_POOL_MAX=10
DB_POOL_MIN=2

# --- JWT -------------------------------------------------------------------
# Must decode to at least 256 bits. Generate one with:
#   openssl rand -base64 48
# Rotating this invalidates every issued access token, which is the intended
# emergency response to a leak.
JWT_SECRET=
JWT_ISSUER=jewellery-erp
JWT_ACCESS_TOKEN_VALIDITY=PT15M
JWT_REFRESH_TOKEN_VALIDITY=P7D

# --- CORS ------------------------------------------------------------------
# Comma separated, explicit origins. A wildcard is rejected under the prod
# profile.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Initial administrator -------------------------------------------------
# Used once, at start-up, only when no active administrator exists. The password
# is hashed with BCrypt before it is stored and is never written to the logs.
# The account is created with "must change password" set, and you should remove
# these variables from the environment after the first sign-in.
INITIAL_ADMIN_ENABLED=true
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=owner@example.com
INITIAL_ADMIN_FULL_NAME=System Administrator
